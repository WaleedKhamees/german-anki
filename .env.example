# danki configuration.
# install.sh copies this file to ~/.config/danki/.env (only if that file does not
# exist yet). Edit the copy, not this file. Lines are KEY=value; `~` is expanded.
# Read by the Python tools AND by both mpv scripts. Environment variables of the same
# name override the file (Python side only).

# --- secrets ------------------------------------------------------------------
# https://openrouter.ai/keys — used to write the definition and example sentences
OPENROUTER_API_KEY=

# --- Anki ---------------------------------------------------------------------
ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_DECK=🇩🇪 German
# note type with the fields: Word, Definition, Conjugation, Screenshot, SourceAudio,
# Examples, Pronunciation   (`danki doctor` checks this)
ANKI_NOTE_TYPE=Basic with example
# deck for the sentence cards (mpv: SENTENCE_HOTKEY)
ANKI_SENTENCE_DECK=🇩🇪 German Sentence Mining
LLM_MODEL=deepseek/deepseek-v4-flash:floor
# length of the example sentences on word cards, in words (Tatoeba and LLM-written);
# `--min-words` / `--max-words` override these for one run
EXAMPLE_MIN_WORDS=10
EXAMPLE_MAX_WORDS=25

# --- files --------------------------------------------------------------------
# queued captures (queue/), their screenshots+audio (assets/), dictionary, sync state
DANKI_DATA_DIR=~/.local/share/danki
# the CLI the mpv scripts call (install.sh links it here)
DANKI_BIN=~/.local/bin/danki

# --- subtitles (`danki subs`) -------------------------------------------------
# Empty paths mean the whisper.cpp that install.sh builds and its models, in
# <DANKI_DATA_DIR>/whisper.cpp. Set them to use a whisper.cpp you built yourself.
WHISPER_CLI=
# small-q8_0 is a good speed/quality balance; medium or large-v3 are better but slower
WHISPER_MODEL=
# Silero VAD keeps the subtitles in sync during music
WHISPER_VAD_MODEL=
# CPU threads (empty = all)
WHISPER_THREADS=
# spoken language when `--lang` isn't given
WHISPER_LANGUAGE=de

# --- mpv: word capture (danki-capture) ---------------------------------------
CAPTURE_HOTKEY=ctrl+w
# sentence capture for ANKI_SENTENCE_DECK ("" to disable)
SENTENCE_HOTKEY=ctrl+e
# make the card for every capture right away (yes/no); "no" only queues it for `danki retry`
CAPTURE_AUTO_ADD=yes

# --- mpv: subtitle colouring (danki-subs) ------------------------------------
SUBS_ENABLED=yes
SUBS_TOGGLE_KEY=alt+c
# seconds between Anki checks while a video is open (0 = only on load / after a capture)
SUBS_POLL_SECONDS=10
# colours are ASS BGR hex (blue-green-red)
SUBS_COLOR_OK=FFFFFF
# in Anki with the screenshot but without the audio (light blue)
SUBS_COLOR_NOAUDIO=FFC866
# in Anki without the screenshot (yellow)
SUBS_COLOR_MISSING=00E5FF
SUBS_COLOR_UNKNOWN=5A5AFF
SUBS_COLOR_NODICT=B4B4B4
SUBS_COLOR_PLAIN=FFFFFF
SUBS_BACKGROUND=yes
SUBS_BG_COLOR=000000
# 00 = opaque ... FF = invisible
SUBS_BG_ALPHA=00
SUBS_BG_PADDING=10
